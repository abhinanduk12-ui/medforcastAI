# ==============================================================================
# MedForecast AI - Environment Configuration
# ==============================================================================

# --- Application & Auth ---
# Set to "0" to disable sign-in (development only). Default: "1"
MEDFORECAST_AUTH=1

# Set to "1" in production with HTTPS so auth cookies require Secure flag
MEDFORECAST_COOKIE_SECURE=0

# Public URL of the web frontend (used in links sent via email/WhatsApp)
MEDFORECAST_APP_URL=http://localhost:3000

# Backend API URL (used by Next.js to proxy /api requests)
MEDFORECAST_API=http://127.0.0.1:8000

# --- Hardware & ML ---
# "auto" (default: probe CUDA, fallback to CPU), "cpu", or "cuda"
MEDFORECAST_DEVICE=auto

# --- AI Copilot (Optional) ---
# If provided, Copilot uses Claude with tool calling. If unset, uses local engine.
ANTHROPIC_API_KEY=

# --- Morning Brief - Email Delivery (Optional SMTP) ---
# MEDFORECAST_SMTP_HOST=smtp.gmail.com
# MEDFORECAST_SMTP_PORT=587
# MEDFORECAST_SMTP_USER=alerts@example.com
# MEDFORECAST_SMTP_PASSWORD=app-password
# MEDFORECAST_SMTP_FROM="MedForecast AI <alerts@example.com>"
# MEDFORECAST_SMTP_TLS=starttls

# --- Morning Brief & Refill Reminders - WhatsApp (Optional Meta Cloud API) ---
# MEDFORECAST_WA_TOKEN=EAAG...
# MEDFORECAST_WA_PHONE_ID=100609...
# MEDFORECAST_WA_API_VERSION=v21.0
# MEDFORECAST_WA_TEMPLATE=daily_brief
# MEDFORECAST_WA_TEMPLATE_LANG=en
